<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The yard's public signalbox page, kept alive: the server itself
     (scripts/serve.mjs in the operator's checkout) in the foreground, which
     launchd starts at login and starts again whenever it exits, for any
     reason. No pull and no build: the last deployed build is served again.
     The yardmaster installs this file (it is not run from here): copy it to
     ~/Library/LaunchAgents and load it once; when the checkout moves, the
     paths below move with it. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.yardr.signalbox-serve</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/node</string>
		<string>/Users/mckean/projects/repos/signalbox/scripts/serve.mjs</string>
		<string>--host</string>
		<string>0.0.0.0</string>
		<string>--port</string>
		<string>8792</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/mckean</string>
		<key>PATH</key>
		<string>/Users/mckean/go/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>YARDR_HOME</key>
		<string>/Users/mckean/.yardr</string>
		<key>YARDR_WEB</key>
		<string>http://127.0.0.1:8791</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/mckean/projects/repos/signalbox</string>
	<key>StandardOutPath</key>
	<string>/Users/mckean/.yardr/logs/signalbox-serve.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/mckean/.yardr/logs/signalbox-serve.log</string>
	<key>RunAtLoad</key>
	<true/>
	<!-- The server is this job's own process: whenever it exits, for any
	     reason, launchd starts it again. The pid file
	     (~/.yardr/signalbox/serve.pid) is written by scripts/serve-public.sh,
	     which restarts the job with launchctl kickstart -k and checks the
	     page it serves. -->
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
</dict>
</plist>
